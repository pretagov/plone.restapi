<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:cache="http://namespaces.zope.org/cache"
    xmlns:plone="http://namespaces.plone.org/plone"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    >

  <plone:service
      method="GET"
      factory=".get.ContentGet"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      />

  <plone:service
      method="GET"
      factory=".get.ContentGet"
      for="Products.CMFCore.interfaces.IContentish"
      permission="zope2.View"
      />
  <cache:ruleset
      for=".get.ContentGet"
      ruleset="plone.content.dynamic"
      zcml:condition="have plone-app-caching-3"
      />

  <plone:service
      method="PATCH"
      factory=".update.ContentPatch"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="cmf.ModifyPortalContent"
      />

  <plone:service
      method="PATCH"
      factory=".update.ContentPatch"
      for="Products.CMFCore.interfaces.IContentish"
      permission="cmf.ModifyPortalContent"
      />

  <plone:service
      method="POST"
      factory=".add.FolderPost"
      for="Products.CMFCore.interfaces.IFolderish"
      permission="cmf.AddPortalContent"
      />

  <plone:service
      method="DELETE"
      factory=".delete.ContentDelete"
      for="Products.CMFCore.interfaces.IContentish"
      permission="zope2.DeleteObjects"
      />

  <plone:service
      method="GET"
      factory=".sharing.SharingGet"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="@sharing"
      />

  <plone:service
      method="GET"
      factory=".sharing.SharingGet"
      for="Products.CMFCore.interfaces.IContentish"
      permission="zope2.View"
      name="@sharing"
      />

  <plone:service
      method="POST"
      factory=".sharing.SharingPost"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="zope2.View"
      name="@sharing"
      />

  <plone:service
      method="POST"
      factory=".sharing.SharingPost"
      for="Products.CMFCore.interfaces.IContentish"
      permission="zope2.View"
      name="@sharing"
      />

  <plone:service
      method="OPTIONS"
      factory=".tus.UploadOptions"
      for="Products.CMFCore.interfaces.IFolderish"
      permission="cmf.AddPortalContent"
      name="@tus-upload"
      />

  <plone:service
      method="POST"
      factory=".tus.UploadPost"
      for="Products.CMFCore.interfaces.IFolderish"
      permission="cmf.AddPortalContent"
      name="@tus-upload"
      />

  <plone:service
      method="POST"
      factory=".tus.UploadPost"
      for="Products.CMFCore.interfaces.IContentish"
      permission="cmf.ModifyPortalContent"
      name="@tus-replace"
      />

  <plone:service
      method="HEAD"
      factory=".tus.UploadHead"
      for="Products.CMFCore.interfaces.IContentish"
      permission="zope2.View"
      name="@tus-upload"
      />

  <plone:service
      method="HEAD"
      factory=".tus.UploadHead"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="cmf.AddPortalContent"
      name="@tus-upload"
      />

  <plone:service
      method="PATCH"
      factory=".tus.UploadPatch"
      for="Products.CMFCore.interfaces.IContentish"
      permission="zope2.View"
      name="@tus-upload"
      />

  <plone:service
      method="PATCH"
      factory=".tus.UploadPatch"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="cmf.AddPortalContent"
      name="@tus-upload"
      />

  <plone:service
      method="DELETE"
      factory=".tus.UploadDelete"
      for="Products.CMFCore.interfaces.IContentish"
      permission="zope2.View"
      name="@tus-upload"
      />

  <plone:service
      method="DELETE"
      factory=".tus.UploadDelete"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="cmf.AddPortalContent"
      name="@tus-upload"
      />

  <!--
    Internal endpoint used by the nginx ``auth_request`` directive in the
    direct-to-S3 data-plane offload. Returns headers telling nginx whether
    to forward the chunk to S3 (with a presigned URL) or back to Plone.
    Registered for both folderish containers and the site root, mirroring
    the @tus-upload PATCH registrations.
  -->
  <plone:service
      method="GET"
      factory=".tus.UploadAuthorize"
      for="Products.CMFCore.interfaces.IContentish"
      permission="zope2.View"
      name="@tus-authorize"
      />

  <plone:service
      method="GET"
      factory=".tus.UploadAuthorize"
      for="Products.CMFPlone.interfaces.IPloneSiteRoot"
      permission="cmf.AddPortalContent"
      name="@tus-authorize"
      />

</configure>
